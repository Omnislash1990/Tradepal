# Copy this file to .env.local and fill in the values you have.
# Everything is optional for local development: without keys the app runs in
# demo mode (simulated payments, built-in estimator, emails logged to the admin outbox).

# Public URL of the site (used for payment redirects and email links)
APP_URL=http://localhost:3000

# Database. Local SQLite file by default.
# Vercel cannot keep a SQLite file: add Turso (Vercel marketplace) and set these, or
# TURSO_DATABASE_URL + TURSO_AUTH_TOKEN from the Turso integration.
DATABASE_URL=file:./data/tradepal.db
DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Payments (Stripe Checkout). Prefer a restricted key (rk_...) from a Stripe sandbox.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional language model used only to understand free-text job descriptions.
# Quantities are always calculated by the built-in estimator.
# AI_PROVIDER=gemini | openai | anthropic  (defaults to gemini when GEMINI_API_KEY is set)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Daily cap on language-model calls (the built-in estimator is not capped)
AI_DAILY_LLM_LIMIT=500

# Transactional email via Resend (https://resend.com). Leave blank to log emails to the admin outbox.
RESEND_API_KEY=
EMAIL_FROM="Tradepal <orders@example.com>"
